{
  "name": "moneysleep-slovar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-packs.ts",
    "scaffold-pack": "node scripts/scaffold-pack.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "voice": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA tools/voice/voice.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "fake-indexeddb": "6.2.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "idb": "8.0.4"
  }
}
