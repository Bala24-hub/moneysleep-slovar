    },
    "matrix.kitchen.08": {
      "text": "Something yummy is in the oven!",
      "audio": "matrix.kitchen.08.mp3"
    },
    "matrix.kitchen.09": {
      "text": "I look out the window.",
      "audio": "matrix.kitchen.09.mp3"
    },
    "matrix.kitchen.10": {
      "text": "What a nice day!",
      "audio": "matrix.kitchen.10.mp3"
    },
    "matrix.kitchen.11": {
      "text": "Now I set the table.",
      "audio": "matrix.kitchen.11.mp3"
    },
    "matrix.kitchen.12": {
      "text": "I put the placemat on the table.",
      "audio": "matrix.kitchen.12.mp3"
    },
    "matrix.kitchen.13": {
      "text": "I put the plate on the placemat.",
      "audio": "matrix.kitchen.13.mp3"
    },
    "matrix.kitchen.14": {
      "text": "Here is my fork, my knife and my spoon.",
      "audio": "matrix.kitchen.14.mp3"
    },
    "matrix.kitchen.15": {
      "text": "Here is my cup and my bowl.",
      "audio": "matrix.kitchen.15.mp3"
    },
    "matrix.kitchen.16": {
      "text": "I sit on my chair.",
      "audio": "matrix.kitchen.16.mp3"
    },
    "matrix.kitchen.17": {
      "text": "Yum, yum, yum!",
      "audio": "matrix.kitchen.17.mp3"
    },
    "matrix.kitchen.18": {
      "text": "All done!",
      "audio": "matrix.kitchen.18.mp3"
    },
    "matrix.kitchen.19": {
      "text": "Time to clean up!",
      "audio": "matrix.kitchen.19.mp3"
    },
    "matrix.kitchen.20": {
      "text": "I clear the table.",
      "audio": "matrix.kitchen.20.mp3"
    },
    "matrix.kitchen.21": {
      "text": "I scrape my plate into the trash can.",
      "audio": "matrix.kitchen.21.mp3"
    },
    "matrix.kitchen.22": {
      "text": "I load the dishwasher.",
      "audio": "matrix.kitchen.22.mp3"
    },
    "matrix.kitchen.23": {
      "text": "I wash the pot in the sink and dry it with the kitchen towel.",
      "audio": "matrix.kitchen.23.mp3"
    },
    "matrix.kitchen.24": {
      "text": "The cutting board goes back in its place.",
      "audio": "matrix.kitchen.24.mp3"
    },
    "matrix.kitchen.25": {
      "text": "I wipe the table.",
      "audio": "matrix.kitchen.25.mp3"
